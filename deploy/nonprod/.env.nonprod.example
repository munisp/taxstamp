# Copy to .env.nonprod, chmod 600, and supply unique values through an approved secret manager.
# Never commit the completed file. Use HTTPS domains and valid certificates before exposure.
TAXSTAMP_ENV=staging
KEYCLOAK_DB_USER=REPLACE_FROM_SECRET_MANAGER
KEYCLOAK_DB_PASSWORD=REPLACE_FROM_SECRET_MANAGER
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=REPLACE_FROM_SECRET_MANAGER
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_FROM_SECRET_MANAGER
PERMIFY_DB_USER=REPLACE_FROM_SECRET_MANAGER
PERMIFY_DB_PASSWORD=REPLACE_FROM_SECRET_MANAGER
KEYCLOAK_HOSTNAME=id.nonprod.example.ng
PERMIFY_HOSTNAME=authz.nonprod.example.ng
APISIX_ADMIN_HOSTNAME=admin-gateway.nonprod.example.ng
GF_SECURITY_ADMIN_USER=REPLACE_FROM_SECRET_MANAGER
GF_SECURITY_ADMIN_PASSWORD=REPLACE_FROM_SECRET_MANAGER
TAXSTAMP_DATABASE_URL=postgresql+psycopg://REPLACE
TAXSTAMP_REDIS_URL=rediss://REPLACE
TAXSTAMP_API_TOKEN_SECRET=REPLACE_WITH_UNIQUE_48_CHAR_MINIMUM_SECRET
TAXSTAMP_DEVICE_HMAC_SECRET=REPLACE_WITH_UNIQUE_48_CHAR_MINIMUM_SECRET
TAXSTAMP_PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_UNIQUE_48_CHAR_MINIMUM_SECRET
TAXSTAMP_AUDIT_CHAIN_SECRET=REPLACE_WITH_UNIQUE_48_CHAR_MINIMUM_SECRET
# Required for staging/production startup. These values identify controls and
# evidence only; never place a KMS credential or plaintext key in this file.
TAXSTAMP_STORAGE_ENCRYPTION_REQUIRED=true
TAXSTAMP_KMS_PROVIDER=aws_kms
TAXSTAMP_KMS_KEY_REFERENCE=arn:aws:kms:REGION:ACCOUNT_ID:key/REPLACE_WITH_KEY_ID
TAXSTAMP_KMS_HSM_BACKED=true
TAXSTAMP_KMS_KEY_ROTATION_DAYS=365
TAXSTAMP_STORAGE_ENCRYPTION_EVIDENCE_URI=https://evidence.example.ng/changes/REPLACE_WITH_CHANGE_ID
TAXSTAMP_POSTGRES_STORAGE_ENCRYPTION_ATTESTED=true
TAXSTAMP_REDIS_STORAGE_ENCRYPTION_ATTESTED=true
# Set true before configuring TAXSTAMP_OPENSEARCH_URL; the checker also requires
# a separately completed OpenSearch asset record in the attestation document.
TAXSTAMP_OPENSEARCH_STORAGE_ENCRYPTION_ATTESTED=false

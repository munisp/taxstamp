# Copy to .env for local development. NEVER commit real secrets.
TAXSTAMP_ENV=development
TAXSTAMP_DATABASE_URL=postgresql+psycopg://taxstamp:taxstamp@localhost:5432/taxstamp
TAXSTAMP_REDIS_URL=redis://localhost:6379/0
# 64 hex chars minimum. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
TAXSTAMP_API_TOKEN_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_0000000000000000000000000000000000
TAXSTAMP_DEVICE_HMAC_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_1111111111111111111111111111111111
TAXSTAMP_PAYMENT_WEBHOOK_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_2222222222222222222222222222222
TAXSTAMP_AUDIT_CHAIN_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_3333333333333333333333333333333333
TAXSTAMP_REQUIRE_TLS=false
TAXSTAMP_CORS_ALLOWED_ORIGINS=
# External systems of record. Empty means "not configured": dependent flows are
# explicitly rejected with HTTP 503 rather than silently succeeding.
TAXSTAMP_FIRS_BASE_URL=
TAXSTAMP_NAFDAC_BASE_URL=
TAXSTAMP_SON_BASE_URL=
TAXSTAMP_CUSTOMS_BASE_URL=
TAXSTAMP_LEDGER_ANCHOR_BASE_URL=

# Integration-ready target architecture. Keep every value empty until the related
# environment, credentials, policy and conformance evidence are approved.
TAXSTAMP_TIGERBEETLE_ADDRESSES=
TAXSTAMP_MOJALOOP_BASE_URL=
TAXSTAMP_KAFKA_BOOTSTRAP_SERVERS=
TAXSTAMP_KAFKA_SECURITY_PROTOCOL=SASL_SSL
TAXSTAMP_KAFKA_TOPIC=taxstamp.events.v1
TAXSTAMP_KAFKA_PUBLISH_TIMEOUT_SECONDS=10
TAXSTAMP_APISIX_ADMIN_URL=
TAXSTAMP_KEYCLOAK_ISSUER_URL=
TAXSTAMP_OPENAPPSEC_MANAGEMENT_URL=
TAXSTAMP_PERMIFY_BASE_URL=
TAXSTAMP_OPENSEARCH_URL=
TAXSTAMP_FLUVIO_CLUSTER_URL=
TAXSTAMP_DAPR_HTTP_URL=
TAXSTAMP_LAKEHOUSE_CATALOG_URL=

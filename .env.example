# Copy to .env for local development. NEVER commit real secrets.
TAXSTAMP_ENV=development
TAXSTAMP_DATABASE_URL=postgresql+psycopg://taxstamp:taxstamp@localhost:5432/taxstamp
TAXSTAMP_REDIS_URL=redis://localhost:6379/0
# 64 hex chars minimum. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
TAXSTAMP_API_TOKEN_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_0000000000000000000000000000000000
TAXSTAMP_DEVICE_HMAC_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_1111111111111111111111111111111111
TAXSTAMP_PAYMENT_WEBHOOK_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_2222222222222222222222222222222
TAXSTAMP_AUDIT_CHAIN_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_3333333333333333333333333333333333
TAXSTAMP_EXPORT_SIGNING_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_4444444444444444444444444444444444
TAXSTAMP_TRANSPARENCY_SIGNING_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_5555555555555555555555555555
TAXSTAMP_OFFLINE_SIGNING_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_6666666666666666666666666666666
TAXSTAMP_OFFLINE_FILTER_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_9999999999999999999999999999999
TAXSTAMP_CONSUMER_FINGERPRINT_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_777777777777777777777777777
TAXSTAMP_REQUIRE_TLS=false
TAXSTAMP_CORS_ALLOWED_ORIGINS=
# External systems of record. Empty means "not configured": dependent flows are
# explicitly rejected with HTTP 503 rather than silently succeeding.
TAXSTAMP_FIRS_BASE_URL=
TAXSTAMP_NAFDAC_BASE_URL=
TAXSTAMP_SON_BASE_URL=
TAXSTAMP_CUSTOMS_BASE_URL=
TAXSTAMP_LEDGER_ANCHOR_BASE_URL=
# Federated identity for human principals (Keycloak or any OIDC provider). Empty issuer
# means "not configured": provider tokens are then refused rather than trusted, and only
# the platform's own opaque credentials are accepted. Devices never use this path.
TAXSTAMP_OIDC_ISSUER=
TAXSTAMP_OIDC_AUDIENCE=
# Defaults to <issuer>/protocol/openid-connect/certs when empty.
TAXSTAMP_OIDC_JWKS_URL=
# Clock skew tolerated on exp/iat/nbf, and how long a fetched key set is reused. A short
# cache means a revoked signing key stops working quickly; too short and every request
# waits on the provider.
TAXSTAMP_OIDC_LEEWAY_SECONDS=30
TAXSTAMP_OIDC_JWKS_CACHE_SECONDS=600
# What counts as multi-factor, as asserted by the provider in amr and acr respectively.
TAXSTAMP_OIDC_MFA_METHODS=mfa,otp,hwk,swk,pop
TAXSTAMP_OIDC_MFA_ACR=mfa
# Roles that may not hold a federated session without one of the assertions above.
TAXSTAMP_OIDC_MFA_REQUIRED_ROLES=admin,supervisor,treasury,auditor
# External authorisation engine (Permify). Mode is disabled, shadow or enforcing.
# Enforcing refuses any request the engine cannot answer, so only select it once the
# engine is deployed highly available.
TAXSTAMP_PERMIFY_BASE_URL=
TAXSTAMP_PERMIFY_TENANT_ID=
TAXSTAMP_PERMIFY_API_KEY=
# Pin a schema version to make decisions reproducible; empty asks for the latest.
TAXSTAMP_PERMIFY_SCHEMA_VERSION=
TAXSTAMP_PERMIFY_TIMEOUT_SECONDS=1.0
TAXSTAMP_AUTHZ_EXTERNAL_MODE=disabled
